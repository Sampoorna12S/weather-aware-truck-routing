# Copy to .env and adjust. Never commit real keys.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Routing: "osrm" (public demo, no key) or "ors" (OpenRouteService, needs a free key)
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
ORS_API_KEY=
ORS_PROFILE=driving-hgv

# Optional overrides (defaults are the public free endpoints)
PHOTON_BASE_URL=https://photon.komoot.io
GEOCODING_FALLBACK_URL=https://geocoding-api.open-meteo.com/v1/search
WEATHER_BASE_URL=https://api.open-meteo.com
LOG_LEVEL=INFO
