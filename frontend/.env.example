# Leave empty in development (Vite proxies /api to http://127.0.0.1:8000).
# In production set to the deployed backend origin, e.g. https://your-api.onrender.com
VITE_API_BASE_URL=

# Vector tile style (OpenFreeMap: free, no key). Replace to switch tile provider.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
